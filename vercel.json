{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/src/server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/src/server"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
