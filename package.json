{
  "name": "annsshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"PORT=7071 npm --prefix api start\"",
    "dev:web": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm --prefix api test",
    "check": "npm run lint && npm run test && npm run build && npm --prefix api run check && npm audit --omit=dev && npm --prefix api audit --omit=dev",
    "preview": "vite preview",
    "postinstall": "npm --prefix api ci --omit=dev",
    "start": "npm --prefix api start"
  },
  "dependencies": {
    "@firebase/app": "^0.16.3",
    "@firebase/auth": "^1.13.7",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
